# Sert l'application Angular et relaie /api vers le backend Spring.
# API_UPSTREAM est fourni par l'environnement (ex. http://api:8093).

# Derrière l'ALB, le protocole d'origine (http ou https) arrive dans X-Forwarded-Proto.
# On le transmet tel quel au backend ; sans ALB (docker compose local), on utilise $scheme.
map $http_x_forwarded_proto $proto_origine {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proto_origine;
    }

    # Fichiers avec empreinte : cache long.
    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Routes Angular : toujours renvoyer index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location = /healthz { return 200 "ok"; }
}
